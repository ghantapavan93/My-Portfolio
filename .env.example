# ─────────────────────────────────────────────────────────────────────────────
# AI agent keys — used ONLY server-side by api/chat.js
# ⚠️  NEVER prefix these with VITE_  — Vite bundles VITE_* vars into the public
#     browser code. These must stay server-side.
#
# Local dev:   copy this file to `.env.local`, fill in what you use, `npm run dev`
# Production:  add these in Vercel → Project → Settings → Environment Variables
#
# Every provider below is OPTIONAL. api/chat.js tries them in this order and
# falls through on rate limits/errors. With none set, the chat uses its
# pre-written answers.
# ─────────────────────────────────────────────────────────────────────────────

# 1) Self-hosted / any OpenAI-compatible endpoint (free, fully open)
#    Ollama local dev:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b-instruct
#    A VM running Ollama/vLLM, or Hugging Face router (https://router.huggingface.co/v1) also work.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Per-request timeout for this provider (ms). Default 20000.
LLM_TIMEOUT_MS=

# 2) Groq — free, no card, open models: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (comma-separated, tried in order). Default: qwen/qwen3.8-27b,openai/gpt-oss-120b
GROQ_MODELS=

# 3) Cloudflare Workers AI — 10K free neurons/day: dash.cloudflare.com → Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=

# 4) OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 5) Gemini (not open-weight; free tier) — last resort: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# (Voice) ElevenLabs — used only by the one-time audio-generation script,
# not at runtime. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
