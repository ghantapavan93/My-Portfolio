{
    "git": {
        "deploymentEnabled": {
            "main": true
        }
    },
    "build": {
        "env": {
            "GIT_LFS_SKIP_SMUDGE": "0"
        }
    },
    "rewrites": [
        {
            "source": "/work/:slug",
            "destination": "/work/:slug/index.html"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
